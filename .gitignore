# NodeJS
node_modules/

# Project-specific
dist/
staging/

# Local working plans — kept out of the repo.
.claude/plans/

# Every generated report, cache, queue and intermediate is written under
# scratch/, and NOTHING there is ever committed: missing-fields reports,
# extraction prompts, audit slices, paper-watch digests, DOI audits, triage
# checklists. All of it is regenerable from the data plus the corpus. If
# something under scratch/ turns out to be worth keeping, it belongs in a GitHub
# issue, not in the repo.
scratch/

# Paper-watch incremental state — persisted between CI runs via actions/cache,
# never committed (and written locally by a dry run with --write-state).
.github/paper-watch/

# Local environment / secrets (e.g. OPENALEX_API_KEY for paper-watch).
# Loaded by `npm run paper-watch` via node --env-file-if-exists; never committed.
# CI supplies the same vars from workflow secrets, so no .env exists there.
.env
.env.*

# MacOS
.DS_Store
