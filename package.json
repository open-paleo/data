{
  "name": "open-paleo-data",
  "version": "1.0.0",
  "description": "Community-maintained phylogenetic dataset for paleontology",
  "type": "module",
  "scripts": {
    "validate": "node --experimental-strip-types scripts/validate.ts",
    "build": "node --experimental-strip-types scripts/build.ts",
    "generate-bindings": "mkdir -p dist/bindings && json2ts schemas/open-paleo.schema.json -o dist/bindings/open-paleo.d.ts && python3 -m datamodel_code_generator --input schemas/open-paleo.schema.json --input-file-type jsonschema --output-model-type pydantic_v2.BaseModel --disable-timestamp --collapse-root-models --output dist/bindings/open_paleo.py",
    "generate-dictionary": "node --experimental-strip-types scripts/generate-dictionary.ts",
    "lint": "eslint scripts/ .github/scripts/",
    "lint:fix": "eslint scripts/ .github/scripts/ --fix",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "research": "node --experimental-strip-types scripts/research.ts",
    "report-missing-fields": "node --experimental-strip-types scripts/report-missing-fields.ts",
    "audit-dois": "node --env-file-if-exists=.env --experimental-strip-types scripts/audit-dois.ts",
    "audit-cited-papers": "node --experimental-strip-types scripts/audit-cited-papers.ts",
    "verify-data-integrity": "node --experimental-strip-types scripts/verify-data-integrity.ts",
    "diagnostic-corpus-candidates": "node --experimental-strip-types scripts/diagnostic-corpus-candidates.ts",
    "paper-watch": "node --env-file-if-exists=.env --experimental-strip-types scripts/paper-watch.ts",
    "build-extraction-prompts": "node --experimental-strip-types scripts/build-extraction-prompts.ts",
    "normalize-extractions": "node --experimental-strip-types scripts/normalize-extractions.ts",
    "spellcheck-extractions": "node --experimental-strip-types scripts/spellcheck-extractions.ts",
    "normalize-genera-text": "node --experimental-strip-types scripts/normalize-genera-text.ts",
    "strip-specimen-ids": "node --experimental-strip-types scripts/strip-specimen-ids-from-material.ts",
    "apply-paper-fields": "node --experimental-strip-types scripts/apply-paper-field-extractions.ts",
    "intake-bootstrap": "node --experimental-strip-types scripts/intake-bootstrap.ts",
    "intake-resume": "node --experimental-strip-types scripts/intake-resume.ts",
    "intake-apply": "node --experimental-strip-types scripts/intake-apply.ts",
    "intake-species-bootstrap": "node --experimental-strip-types scripts/intake-species-bootstrap.ts",
    "intake-species-resume": "node --experimental-strip-types scripts/intake-species-resume.ts",
    "intake-species-apply": "node --experimental-strip-types scripts/intake-species-apply.ts"
  },
  "license": "CC-BY-4.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.2",
    "cspell": "10.4.0",
    "eslint": "10.13.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "typescript7": "npm:typescript@7.0.2"
  }
}
